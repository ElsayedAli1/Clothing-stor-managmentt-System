@*-------------------- العبد ستور - Layout --------------------*@
@{
    var role = Context.Session.GetString("Role");
    var username = Context.Session.GetString("Username");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - العبد ستور</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- شريط علوي -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">العبد ستور</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a>
                    </li>

                    @if (role == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">المنتجات</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Purchases" asp-action="Index">المشتريات</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Category" asp-action="Index">التصنيفات</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">العملاء</a></li>
                        <!-- ✅ زرار المصروفات الجديد -->
                        <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Index">المصروفات</a></li>

                    }

                    @if (role == "Admin" || role == "Employee")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Create">إنشاء فاتورة بيع</a></li>
                         }
                </ul>

                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="text-white me-3">مرحبًا، @username</span>
                        <a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="ChangePassword">تغيير كلمة السر</a>
                        <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">تسجيل الخروج</a>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- المحتوى -->
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- تذييل -->
    <footer class="bg-primary text-white text-center py-3 mt-4">
        جميع الحقوق محفوظة © @DateTime.Now.Year العبد ستور
    </footer>
    @* <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
