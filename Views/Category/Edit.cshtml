@model ElabdStor.Models.Category
@{
    ViewData["Title"] = "تعديل تصنيف";
}

<h2 class="text-warning mb-3">تعديل التصنيف</h2>

<form asp-action="Edit" method="post" class="bg-white p-4 rounded shadow-sm">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">تعديل</button>
    <a asp-action="Index" class="btn btn-secondary">عودة للقائمة</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
