@model ElabdStor.ViewModels.PurchaseDetailsViewModel

<h2 class="text-primary mb-3">تفاصيل الفاتورة</h2>

<div class="mb-3">
    <strong>اسم المورد:</strong> @Model.SupplierName <br />
    <strong>رقم الهاتف:</strong> @Model.SupplierPhone <br />
    <strong>إجمالي الفاتورة:</strong> @Model.TotalAmount.ToString("0.00") ج.م
</div>

<table class="table table-bordered table-striped text-center align-middle">
    <thead class="table-light">
        <tr>
            <th>كود المنتج</th>
            <th>اسم المنتج</th>
            <th>سعر الوحدة</th>
            <th>الكمية</th>
            <th>الإجمالي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductCode</td>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("0.00")</td>
                <td>@item.Quantity</td>
                <td>@item.ItemTotal.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary mt-3">
    <i class="bi bi-arrow-left"></i> العودة لقائمة المشتريات
</a>
